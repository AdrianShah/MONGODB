{
  "name": "escrowops",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:chaos": "vitest run --config vitest.chaos.config.ts",
    "test:e2e": "playwright test",
    "test:evals": "vitest run --config vitest.evals.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/web/tsconfig.json",
    "api": "tsx packages/api/src/main.ts",
    "dashboard": "tsx packages/web/src/main.ts",
    "services": "tsx scripts/services.ts",
    "demo:kill": "tsx scripts/demo-kill.ts",
    "demo:rehearse": "tsx scripts/rehearse.ts",
    "apply-policy": "tsx scripts/apply-policy.ts",
    "audit:verify": "tsx scripts/audit-verify.ts",
    "web:build": "npm run build -w @escrowops/web",
    "web:dev": "npm exec -w @escrowops/web -- vite",
    "batch": "tsx packages/agent/src/main.ts",
    "executor": "tsx packages/executor/src/main.ts",
    "fake-provider": "tsx packages/executor/src/providers/fake-http-server.ts",
    "db": "tsx scripts/dev-db.ts",
    "spike": "tsx scripts/spike.ts",
    "setup": "tsx scripts/setup.ts",
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/reset.ts",
    "redteam": "tsx scripts/redteam.ts",
    "precedents:learn": "tsx scripts/learn-precedents.ts",
    "freeze": "tsx scripts/freeze.ts",
    "unfreeze": "tsx scripts/freeze.ts --unfreeze",
    "agent:freeze": "tsx scripts/freeze.ts",
    "agent:unfreeze": "tsx scripts/freeze.ts --unfreeze",
    "demo:jailbreak": "tsx scripts/jailbreak.ts",
    "jailbreak": "tsx scripts/jailbreak.ts",
    "demo:tunnel": "tsx scripts/tunnel.ts"
  },
  "dependencies": {
    "@escrowops/agent": "*",
    "@escrowops/api": "*",
    "@escrowops/executor": "*",
    "@escrowops/shared": "*",
    "@escrowops/web": "*",
    "dotenv": "^18.0.10",
    "mongodb": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.38"
    }
  }
}
