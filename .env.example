# Copy to .env and fill in. Never commit .env.

# Admin connection string (required for scripts). Needs a user that can create
# collections, validators, indexes, roles and users.
#   Local Docker (docker compose up -d):
#     mongodb://admin:admin-dev-password@localhost:27017/?directConnection=true&authSource=admin
#   Atlas:
#     mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Tests (npm test) do NOT read this file: with MONGODB_URI unset in the shell they
# start an in-memory replica set with auth. Export MONGODB_URI to test against a real server.
MONGODB_URI=

# Application database.
MONGODB_DB=escrowops

# Database the role users authenticate against. Defaults to MONGODB_DB.
# On Atlas every database user lives in "admin".
# MONGODB_ROLE_AUTH_SOURCE=admin

# One database user per process. Dev defaults shown; change them anywhere real.
AGENT_DB_USER=escrow_agent
AGENT_DB_PASSWORD=agent-dev-password
APPROVER_DB_USER=escrow_approver
APPROVER_DB_PASSWORD=approver-dev-password
EXECUTOR_DB_USER=escrow_executor
EXECUTOR_DB_PASSWORD=executor-dev-password
DASHBOARD_DB_USER=escrow_dashboard
DASHBOARD_DB_PASSWORD=dashboard-dev-password
ADMIN_DB_USER=escrow_admin
ADMIN_DB_PASSWORD=admin-dev-password
