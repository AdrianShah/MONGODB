# Copy to .env and fill in. Never commit .env.

# Admin connection string (required for scripts). Needs a user that can create
# collections, validators, indexes, roles and users.
#   Local Docker (docker compose up -d):
#     mongodb://admin:admin-dev-password@localhost:27017/?directConnection=true&authSource=admin
#   Atlas:
#     mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Tests (npm test) do NOT read this file: with MONGODB_URI unset in the shell they
# start an in-memory replica set with auth. Export MONGODB_URI to test against a real server.
MONGODB_URI=

# Application database.
MONGODB_DB=escrowops

# Database the role users authenticate against. Defaults to MONGODB_DB.
# On Atlas every database user lives in "admin".
# MONGODB_ROLE_AUTH_SOURCE=admin

# One database user per process. Dev defaults shown; change them anywhere real.
AGENT_DB_USER=escrow_agent
AGENT_DB_PASSWORD=agent-dev-password
APPROVER_DB_USER=escrow_approver
APPROVER_DB_PASSWORD=approver-dev-password
EXECUTOR_DB_USER=escrow_executor
EXECUTOR_DB_PASSWORD=executor-dev-password
DASHBOARD_DB_USER=escrow_dashboard
DASHBOARD_DB_PASSWORD=dashboard-dev-password
ADMIN_DB_USER=escrow_admin
ADMIN_DB_PASSWORD=admin-dev-password

# Agent (npm run batch). Claude credentials: ANTHROPIC_API_KEY, or an `ant auth login` profile.
ANTHROPIC_API_KEY=

# Precedent memory (A7). With a Voyage AI key, precedents and queries are embedded with Voyage
# and searched with Atlas Vector Search; without one a local hash embedding (256 dims) is used.
# After changing these, re-run `npm run setup` and `npm run seed` (the index dimension follows).
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3.5
# VOYAGE_DIMENSIONS=1024     256 | 512 | 1024 | 2048
# EMBEDDING_PROVIDER=local   forces the local embedding even with a key
# AGENT_MODEL=claude-sonnet-5-5
# AGENT_EFFORT=medium        low | medium | high | xhigh | max
# AGENT_CONCURRENCY=4
# AGENT_FALLBACKS=off        disables the server-side refusal fallback

# Approval service (npm run api). Two approver logins, "id:password,id:password".
# Required when MONGODB_URI is not on this machine (e.g. Atlas): the service refuses to start
# with the public dev passwords unless ALLOW_DEV_APPROVERS=1.
# APPROVERS=approver-a:<long password>,approver-b:<long password>
# ALLOW_DEV_APPROVERS=1
# API_HOST=127.0.0.1
# API_PORT=4000

# Dashboard (npm run dashboard). Viewing needs an approver sign-in unless DASHBOARD_PUBLIC=1.
# Use DASHBOARD_HOST=0.0.0.0 to reach it from a phone on the same network.
# DASHBOARD_PORT=4100
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PUBLIC=1

# Voice for approvers (optional). "Listen" on review cards and "Narrate audit trail" on the
# timeline use ElevenLabs text-to-speech through the dashboard server; the key never reaches
# the browser. Unset: the buttons use the browser's built-in speech instead. Voice never approves.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Executor payments (npm run executor).
#   stripe     real Stripe test mode; needs STRIPE_SECRET_KEY (sk_test_...; live keys are refused)
#   fake-http  fake provider that survives executor restarts; start it with `npm run fake-provider`
#   fake       in-memory fake, lost on restart
PAYMENTS=fake-http
STRIPE_SECRET_KEY=
FAKE_PROVIDER_URL=http://127.0.0.1:4700

# Daily cap on auto refunds, in cents (E6). Once reached, auto refunds go to review_queue for
# one approver. Unset or 0 disables it. The demo's 9 auto refunds total $1,320.43.
DAILY_AUTO_BUDGET_CENTS=500000

# Chaos only: SIGKILL the executor at point 1-4, on the n-th time it is reached.
# CRASH_AT=3
# CRASH_ON_HIT=1

# Voice for approvers (dashboard). With a key, "Listen" and "Narrate audit trail" use ElevenLabs
# text-to-speech through the dashboard server; the key never reaches the browser. Without one,
# the browser's speechSynthesis reads the same text. Voice is output-only: it cannot approve.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_flash_v2_5
